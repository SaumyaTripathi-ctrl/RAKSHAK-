# Copy to .env to override. Everything below is DEV-ONLY and has working defaults in docker-compose.yml.

POSTGRES_USER=rakshak
POSTGRES_PASSWORD=rakshak-dev
POSTGRES_DB=rakshak

# MQTT accounts. A device's username is its hub id; "rakshak-api" is the backend service account.
MQTT_API_PASSWORD=dev-api-pass
MQTT_DEVICE_USERS=HUB-0001:dev-hub-0001,HUB-0002:dev-hub-0002,HUB-0003:dev-hub-0003

# 32-byte master key (64 hex chars) from which per-device AES-256 keys are derived (HKDF).
# Dev value = bytes 00..1f, the same as the public test vectors. NEVER use it in production.
RAKSHAK_MASTER_KEY_HEX=000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f

RAKSHAK_JWT_SECRET=dev-only-change-me-dev-only-change-me
